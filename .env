# Copy to .env and edit.

# GitHub organisation that owns the repositories. Fine-grained tokens for a
# machine user need the repositories to be in an organisation it belongs to.
GH_OWNER=tentenths

# Every repository in this project starts with this prefix
# (inkproof-core, inkproof-scale, ...). Status reports filter on it.
REPO_PREFIX=inkproof-

# The machine user the agents act as, its commit email, and your username.
# Only issues and comments by these two accounts reach the agents.
MACHINE_USER=inkproof-tentenths
MACHINE_EMAIL=paul+inkproof@tententhsconsulting.com
HUMAN_USER=paulbutcher

# Must match the host user that owns secrets/ (id -u ; id -g).
HOST_UID=501
HOST_GID=20
